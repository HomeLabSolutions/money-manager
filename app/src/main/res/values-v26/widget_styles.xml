<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Spending.Amount" parent="Widget.Spending.Amount.Base">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">20sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>

    <style name="Widget.Spending.FeaturedAmount" parent="Widget.Spending.Amount">
        <item name="android:layout_height">40dp</item>
        <item name="android:textColor">@color/widget_accent</item>
        <item name="android:autoSizeMaxTextSize">28sp</item>
    </style>
</resources>
